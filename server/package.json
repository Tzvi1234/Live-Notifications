{
  "name": "kickoff-server",
  "version": "1.0.0",
  "private": true,
  "description": "Kickoff backend: polls API-Football, diffs live match events, pushes them to Android over FCM HTTP v1, and serves the app's REST API.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p . && node -e \"import('node:fs').then(({ cpSync }) => cpSync('src/store/schema.sql', 'dist/store/schema.sql'))\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.9.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
