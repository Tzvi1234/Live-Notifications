# Android / Gradle
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/app/google-services.json
*.iml
*.apk
*.aab
*.keystore
*.jks
# ...except the two throwaway keys that sign the side-by-side test flavours. They must be
# in the repository or nobody else can build an alpha/beta that installs over the one they
# already have - a signing key is an identity, and a regenerated one is a different app.
# These sign test builds only and must never reach a store; the real release key is not here.
!android/keystores/alpha.jks
!android/keystores/beta.jks

# Node
server/node_modules/
server/dist/
server/.env
server/*.log

# Secrets
**/firebase-service-account.json
*.pem

# OS
.DS_Store
Thumbs.db

# Generated at configure time from app/google-services.json, with the flavour's package
# name written in - see writeFlavourFirebaseConfig in app/build.gradle.kts. Derived from a
# file that is itself ignored, so it is never the source of truth.
android/app/src/alpha/google-services.json
android/app/src/beta/google-services.json
