<?xml version="1.0" encoding="utf-8"?>
<!--
  Collapsed custom content. Android 12+ caps this at 48dp tall and hands the row's
  header, icon and expand affordance to the system template, so this is one line only.
  RemoteViews accepts a fixed whitelist of view classes: LinearLayout/RelativeLayout/
  GridLayout/FrameLayout and TextView/ImageView/Button/ProgressBar/Chronometer - no
  ConstraintLayout, and no AppCompat/Material subclasses.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/crest_home"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/code_home"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="52dp"
        android:gravity="center"
        android:textStyle="bold"
        android:textSize="17sp"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

    <TextView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="34dp"
        android:gravity="center"
        android:maxLines="1"
        android:textSize="11sp"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />

    <TextView
        android:id="@+id/code_away"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:gravity="end"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/crest_away"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />
</LinearLayout>
