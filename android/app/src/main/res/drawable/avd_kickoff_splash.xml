<?xml version="1.0" encoding="utf-8"?>
<!--
  Launch animation, same story as AnimatedKickoffLogo: the football drops in and
  bounces, the two-tone ring draws itself from the top edge of the opening round to
  the other side, and the loose ball pops in over the gap last.

  windowSplashScreenAnimatedIcon plays this for at most 1000ms, so the whole sequence
  is budgeted to finish inside that.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/kickoff_splash_vector">

    <target android:name="ball_group">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:animation">
            <objectAnimator
                android:propertyName="translateY"
                android:valueFrom="-54"
                android:valueTo="0"
                android:duration="420"
                android:interpolator="@android:interpolator/bounce" />
        </aapt:attr>
    </target>

    <target android:name="ring">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:startOffset="380"
                android:duration="420"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>

    <target android:name="dot_group">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0" android:valueTo="1"
                    android:startOffset="780" android:duration="180"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0" android:valueTo="1"
                    android:startOffset="780" android:duration="180"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
