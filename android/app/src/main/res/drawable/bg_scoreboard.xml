<?xml version="1.0" encoding="utf-8"?>
<!-- The score card's ground: the notification surface itself, so the card reads as part
     of the shade rather than a black panel dropped into it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/notif_surface" />
    <corners android:radius="20dp" />
</shape>
