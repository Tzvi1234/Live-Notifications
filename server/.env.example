# Kickoff server — copy to `.env` for local development (`npm run dev` does not read it
# automatically; use `node --env-file=.env` or export the values in your shell).
# On Render these are set under kickoff-api -> Environment; see docs/DEPLOYMENT.md.
# `.env` is git-ignored. Only this example file is committed.

# --- Runtime -------------------------------------------------------------------------
# Injected by Render in production. Locally, anything free; the server binds 0.0.0.0:$PORT.
PORT=8080
# `production` in deployment, `development` locally. Only affects logging and error detail.
NODE_ENV=development
# debug | info | warn | error. `debug` logs every provider request and its quota headers.
LOG_LEVEL=debug

# --- API-Football (required) ---------------------------------------------------------
# Sign up at https://dashboard.api-football.com, then Profile -> API Key. The direct
# api-sports.io key works with the base URL below; a RapidAPI key does NOT.
API_FOOTBALL_KEY=
# Change only to point at a mock or a proxy.
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# --- Postgres (optional) -------------------------------------------------------------
# On Render this is wired from the kickoff-db database by render.yaml — do not set it there.
# Locally: `postgres://user:password@localhost:5432/kickoff`, or leave EMPTY to run entirely
# in memory (devices and subscriptions then vanish on restart, which is fine for UI work).
DATABASE_URL=

# --- Firebase / FCM (optional; unset = push disabled, REST API still works) -----------
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# On Render, upload that JSON as a Secret File named `firebase-service-account.json` and
# render.yaml points this at /etc/secrets/firebase-service-account.json, where Render mounts
# it. Locally, set it to wherever you saved the file — and leave it EMPTY when you are not
# testing push. A path that does not exist is read at boot and logged as an error; an empty
# value is the documented "push disabled, REST API unaffected" path.
GOOGLE_APPLICATION_CREDENTIALS=
# Alternative to the line above — `base64 -w0 firebase-service-account.json`. Use this when
# a secret file is not available. The file path takes precedence when both are set, so clear
# GOOGLE_APPLICATION_CREDENTIALS if you use this.
FIREBASE_SERVICE_ACCOUNT_B64=
# Firebase console -> Project settings -> General -> Project ID (e.g. kickoff-4f2a1).
# Optional: the Admin SDK reads the id out of the service-account JSON; this only overrides it.
FIREBASE_PROJECT_ID=

# --- Clerk (optional; unset = /v1/me and /v1/groups/* answer 503, everything else works) --
# Clerk dashboard -> API keys. The SECRET key is the one that enables the authenticated
# routes; without it the server still boots and still serves fixtures, notifications and
# devices — it just answers 503 on anything that needs an account.
CLERK_SECRET_KEY=
# The PUBLISHABLE key is a client credential and is served to the app by GET /v1/config, so
# the APK does not have to bake it in and the Clerk instance can be swapped without a
# release. Safe to commit; the secret key above is not.
CLERK_PUBLISHABLE_KEY=
# API keys -> "Show JWT public key" -> PEM. With it, a session token is verified against
# this local key and costs no network round trip per request; without it every authenticated
# request calls Clerk. Escaped \n sequences are unescaped on load, so a single-line paste
# out of a shell or the Render form works.
CLERK_JWT_KEY=

# --- Poller --------------------------------------------------------------------------
# false runs a REST-only instance (useful for a second box, or while debugging the API).
POLL_ENABLED=true
# Cadence while at least one tracked match is in play.
POLL_INTERVAL_SECONDS=30
# Cadence when nothing is live. Must be >= POLL_INTERVAL_SECONDS.
POLL_IDLE_INTERVAL_SECONDS=300
# How far ahead of kick-off the pre-match card and the line-up fetch start.
PREMATCH_LEAD_MINUTES=60
# Your API-Football plan's daily quota (dashboard -> Subscription). The poller stops
# spending and backs off at this number rather than being cut off mid-match.
# Free keys are 100/day — set 100 if you are on Free.
DAILY_REQUEST_BUDGET=7500
# Competition ids offered during onboarding, in order: Premier League (39), La Liga (140),
# Serie A (135), Bundesliga (78), Ligue 1 (61), Champions League (2), Europa League (3),
# Eredivisie (88), Primeira Liga (94), Super Lig (203), Ligat ha'Al (383), MLS (253),
# Brasileirao Serie A (71), Liga Profesional Argentina (128).
FEATURED_LEAGUE_IDS=39,140,135,78,61,2,3,88,94,203,383,253,71,128

# --- API -----------------------------------------------------------------------------
# TTL for catalogue and fixtures-by-date responses. Live endpoints are never cached.
CACHE_TTL_SECONDS=60
# Any string you choose. When set, /v1/admin/* requires `Authorization: Bearer <token>`.
# Leave empty to keep the admin routes off. Render generates one via `generateValue: true`.
ADMIN_TOKEN=
